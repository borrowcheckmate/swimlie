{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "A multi-week training plan; each workout is a full workout.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanWeek"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "weeks"
  ],
  "$defs": {
    "Block": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkoutSet"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sets"
      ]
    },
    "Equipment": {
      "description": "Swim toys a set uses.",
      "type": "string",
      "enum": [
        "fins",
        "paddles",
        "pull_buoy",
        "kickboard",
        "snorkel"
      ]
    },
    "Intensity": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "threshold",
        "hard",
        "sprint"
      ]
    },
    "PlanWeek": {
      "type": "object",
      "properties": {
        "focus": {
          "description": "What the week works on, e.g. \"Build aerobic base\".",
          "type": [
            "string",
            "null"
          ]
        },
        "workouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Workout"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "workouts"
      ]
    },
    "Rest": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/RestKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "seconds"
      ]
    },
    "RestKind": {
      "oneOf": [
        {
          "description": "Start the next rep every `seconds`.",
          "type": "string",
          "const": "interval"
        },
        {
          "description": "Rest `seconds` after finishing the rep.",
          "type": "string",
          "const": "fixed"
        }
      ]
    },
    "Stroke": {
      "description": "Matches `HealthKit`'s swimming stroke styles, plus `Any`.",
      "type": "string",
      "enum": [
        "any",
        "freestyle",
        "backstroke",
        "breaststroke",
        "butterfly",
        "mixed",
        "kickboard"
      ]
    },
    "Workout": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "description": {
          "description": "Short coach note about the swim, e.g. from the AI creator. Optional.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "pool_length_m": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "pool_length_m",
        "blocks"
      ]
    },
    "WorkoutSet": {
      "description": "Named `WorkoutSet` because `Set` clashes with Swift's `Set`; JSON is unaffected.",
      "type": "object",
      "properties": {
        "distance_m": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "drill": {
          "description": "Exercise id from the catalogue (`exercises()`), e.g. \"catch-up\".",
          "type": [
            "string",
            "null"
          ]
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Equipment"
          }
        },
        "goal_s": {
          "description": "Target time per rep in seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "intensity": {
          "$ref": "#/$defs/Intensity",
          "default": "easy"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "reps": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "rest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rest"
            },
            {
              "type": "null"
            }
          ]
        },
        "stroke": {
          "$ref": "#/$defs/Stroke",
          "default": "any"
        }
      },
      "additionalProperties": false,
      "required": [
        "distance_m"
      ]
    }
  }
}
