# Copy to .env (git-ignored). Real environment variables win over this file.
# iPhone to install on: name or identifier from `cargo xtask devices`.
SWIMLIE_PHONE=
# Apple Watch to check for the watch app (name or identifier); optional, only warns.
SWIMLIE_WATCH=
# Apple developer team id used for signing (required by `cargo xtask project`, `install` and `testflight`).
SWIMLIE_TEAM_ID=
# Optional, for `cargo xtask shots`: a real AI key and its provider (mistral, openai, anthropic, gemini, openrouter).
# The AI screenshots are kept in docs/shots/ and only retaken when missing or with REFRESH_AI=1.
API_KEY=
AI_PROVIDER=
# Optional, for `cargo xtask testflight`: App Store Connect API key (Users and Access > Integrations > App Store Connect API).
# Key id and issuer id are shown on that page; the .p8 file can only be downloaded once.
# Any value may be a 1Password reference (op://vault/item/field), read with the `op` CLI, e.g. op://Private/Swimlie ASC/key-id
# Key id: the key id (e.g. op://Private/Swimlie ASC/key-id)
SWIMLIE_ASC_KEY_ID=
# Issuer id: the issuer id (e.g. op://Private/Swimlie ASC/issuer-id)
SWIMLIE_ASC_ISSUER_ID=
# Path to the .p8 file, or a 1Password document reference (e.g. op://Private/Swimlie ASC/AuthKey.p8); the document is written to a temp file and removed after upload
SWIMLIE_ASC_KEY_PATH=
